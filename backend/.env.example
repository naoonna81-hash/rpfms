# RPFMS backend environment variables
# Copy this file to .env and fill in real values for local development.

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://rpfms:rpfms_dev_pw@localhost:5432/rpfms?schema=public"

# JWT secrets - use long random strings in production (e.g. `openssl rand -hex 64`)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

# Token lifetimes
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# HTTP server
PORT=4000
NODE_ENV=development

# CORS - comma separated list of allowed origins
CORS_ORIGIN="http://localhost:3000"

# File storage - local folder for uploaded receipts/attachments.
# Point this at a mounted volume / future cloud-storage sync path in production.
UPLOAD_DIR="./uploads"

# Max upload size in bytes (default 10MB)
MAX_UPLOAD_SIZE_BYTES=10485760
